# Chave da OpenAI para os endpoints de IA (STT Whisper, Chat/Tool Calling e TTS)
# Caso queira executar offline sem chave da OpenAI, use SPRING_PROFILES_ACTIVE=demo
OPENAI_API_KEY=sk-proj-sua-chave-aqui

# Modelos OpenAI opcionais (valores padrão abaixo)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

# Perfil Spring ativo (vazio = H2 + OpenAI, demo = H2 + IA simulada, docker = PostgreSQL)
SPRING_PROFILES_ACTIVE=

# Configurações PostgreSQL (perfil docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=falainteligente
DB_USER=app
DB_PASSWORD=app
